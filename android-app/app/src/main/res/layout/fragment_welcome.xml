<?xml version="1.0" encoding="utf-8"?>
<!--
  The first launch, and the only time this screen exists.

  It sits in the content area with the header and the bottom bar still
  visible, which was a decision rather than a shortcut. A full-bleed takeover
  would say "get past me first"; leaving the app visible around the edges says
  the opposite, and the header behind it is already displaying "Offline · 58
  documents", which is pane two demonstrating itself while pane one is being
  read. The bottom bar stays live for the same reason: a student who would
  rather just start typing can, and the seen-flag is written when this appears
  rather than when it is dismissed, so leaving that way does not bring it back.

  One pane at a time rather than a scrolling list of four. Each claim gets the
  screen to itself and is read; four stacked in a column are skimmed as a
  feature list, which is exactly the register these four have to avoid.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/ink">

    <!-- Top right, present on every pane including the first. -->
    <TextView
        android:id="@+id/welcomeSkip"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:minHeight="@dimen/touch_min"
        android:minWidth="@dimen/touch_min"
        android:gravity="center"
        android:paddingStart="@dimen/space_4"
        android:paddingEnd="@dimen/space_4"
        android:text="@string/welcome_skip"
        android:textSize="@dimen/type_body_sm"
        android:textColor="@color/text_secondary"
        android:background="?attr/selectableItemBackground"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!--
      The pane itself. Vertically centred rather than pinned to the top: there
      are two short paragraphs on a tall screen and hanging them off the top
      bezel leaves a black half-screen underneath that reads as unfinished.

      This is the view the fade-through runs on, so it is one container and not
      two loose TextViews — MaterialFadeThrough scales and fades the thing it
      is given, and giving it two siblings would cross-fade them out of step.
    -->
    <LinearLayout
        android:id="@+id/welcomePane"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/gutter"
        android:paddingEnd="@dimen/gutter"
        app:layout_constraintTop_toBottomOf="@id/welcomeSkip"
        app:layout_constraintBottom_toTopOf="@id/welcomeDots"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintVertical_bias="0.4">

        <TextView
            android:id="@+id/welcomeTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="@dimen/type_title"
            android:textStyle="bold"
            android:letterSpacing="-0.02"
            android:textColor="@color/text_primary"
            android:justificationMode="none" />

        <TextView
            android:id="@+id/welcomeBody"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_4"
            android:textSize="@dimen/type_body"
            android:textColor="@color/text_secondary"
            android:lineSpacingExtra="@dimen/line_extra_body"
            android:justificationMode="none"
            android:hyphenationFrequency="none" />
    </LinearLayout>

    <!-- Four dots, filled in code. Decorative: the same fact is on the action
         button's contentDescription, so a screen reader is not asked to
         interpret opacity. -->
    <LinearLayout
        android:id="@+id/welcomeDots"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="@dimen/space_6"
        android:importantForAccessibility="no"
        app:layout_constraintBottom_toTopOf="@id/welcomeAction"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/welcomeAction"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/gutter"
        android:layout_marginEnd="@dimen/gutter"
        android:layout_marginBottom="@dimen/space_6"
        android:minHeight="@dimen/touch_min"
        android:gravity="center"
        android:background="@drawable/bg_primary_action"
        android:text="@string/welcome_next"
        android:textSize="@dimen/type_body_sm"
        android:textStyle="bold"
        android:textColor="@color/primary_action_text"
        android:focusable="true"
        android:clickable="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
</androidx.constraintlayout.widget.ConstraintLayout>
