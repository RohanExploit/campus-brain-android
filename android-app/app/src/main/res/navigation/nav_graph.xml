<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/nav_graph"
    app:startDestination="@id/askFragment">

    <fragment android:id="@+id/askFragment"
        android:name="com.kriet.campusbrain.ui.ask.AskFragment"
        android:label="@string/tab_ask" />

    <fragment android:id="@+id/resultFragment"
        android:name="com.kriet.campusbrain.ui.result.ResultFragment"
        android:label="@string/tab_result" />

    <fragment android:id="@+id/docsFragment"
        android:name="com.kriet.campusbrain.ui.docs.DocsFragment"
        android:label="@string/tab_docs">
        <action android:id="@+id/toDocDetail" app:destination="@id/docDetailFragment" />
    </fragment>

    <fragment android:id="@+id/docDetailFragment"
        android:name="com.kriet.campusbrain.ui.docs.DocDetailFragment"
        android:label="Document">
        <argument android:name="docId" app:argType="string" />
    </fragment>

    <fragment android:id="@+id/selfTestFragment"
        android:name="com.kriet.campusbrain.ui.selftest.SelfTestFragment"
        android:label="Self test" />

    <!--
      Registered the same way the self test is: a destination with no action
      into it and no tab pointing at it, reached by a gesture from the header.

      Deliberately NOT a bottom-nav item. The four tabs are the things a
      student does with the app; enrolment is something they do once, to the
      app. A fifth tab would also make it look like a place answers come from,
      which is the one impression this feature must not give — nothing on the
      answering path consults it.
    -->
    <fragment android:id="@+id/enrolFragment"
        android:name="com.kriet.campusbrain.ui.auth.EnrolFragment"
        android:label="@string/enrol_title" />

    <!--
      Registered exactly as selfTestFragment and enrolFragment are: a
      destination with no tab pointing at it, reached by a gesture from the
      header. Long-press on the status pill, where a tap already goes to
      enrolment.

      Deliberately NOT a bottom-nav item, and the reason is stronger here than
      it was for enrolment. The four tabs are what a student does with the app.
      A licence tab would put a price next to the thing this product gives away
      — every answer, every route, offline, at every tier — and would make the
      free experience look like a sample of a paid one. It is not one.
    -->
    <fragment android:id="@+id/licenseFragment"
        android:name="com.kriet.campusbrain.ui.license.LicenseFragment"
        android:label="@string/license_title">
        <action android:id="@+id/toAdminAnalytics"
            app:destination="@id/adminAnalyticsFragment" />
    </fragment>

    <!--
      Reachable only from the licence screen, whose link is hidden below the
      institutional tier. One way in, so there is one place that decides.
    -->
    <fragment android:id="@+id/adminAnalyticsFragment"
        android:name="com.kriet.campusbrain.ui.admin.AdminAnalyticsFragment"
        android:label="@string/analytics_title" />

    <!--
      Shown once, on the first launch, and popped by either exit. Also not a
      tab: there is nothing to come back to.
    -->
    <fragment android:id="@+id/welcomeFragment"
        android:name="com.kriet.campusbrain.ui.welcome.WelcomeFragment"
        android:label="@string/app_name" />
</navigation>
