<?xml version="1.0" encoding="utf-8"?>
<!-- Enabled and disabled are genuinely different, not one greyed sprite:
     the old Send button read as disabled even when it was actionable. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="oval">
            <solid android:color="@color/ink_input" />
            <stroke android:width="@dimen/hairline" android:color="@color/hairline" />
        </shape>
    </item>
    <item>
        <shape android:shape="oval">
            <solid android:color="@color/accent" />
        </shape>
    </item>
</selector>
