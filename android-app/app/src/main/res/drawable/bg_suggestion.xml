<?xml version="1.0" encoding="utf-8"?>
<!--
  The suggestion pill, now with a press state.

  It was a bare shape, so a chip that was fully wired — AskFragment attaches a
  click listener to every one of them as it inflates it — gave no sign at all
  that it had been touched. A control that looks pressable, is pressable, and
  acknowledges nothing is indistinguishable from a dead one, and it was
  reported as dead.

  A ripple wrapping the same shape rather than ?attr/selectableItemBackground,
  which would have thrown away the pill: the fill, the radius and the hairline
  are unchanged, and the only difference is that a finger now leaves a mark.
  colorControlHighlight comes from the theme, so no new colour is introduced.
-->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="?attr/colorControlHighlight">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/ink_input" />
            <corners android:radius="@dimen/radius_lg" />
            <stroke android:width="@dimen/hairline" android:color="@color/hairline" />
        </shape>
    </item>
</ripple>
