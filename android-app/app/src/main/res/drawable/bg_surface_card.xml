<?xml version="1.0" encoding="utf-8"?>
<!-- The answer surface. A hairline rather than a shadow: on a near-black
     ground an elevation shadow is invisible, so the border does the work. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android" android:shape="rectangle">
    <solid android:color="@color/ink_raised" />
    <corners android:radius="@dimen/radius_md" />
    <stroke android:width="@dimen/hairline" android:color="@color/hairline" />
</shape>
