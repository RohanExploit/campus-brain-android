<resources>
    <string name="app_name">Campus Brain</string>
    <string name="app_subtitle">AI As A Verifier</string>
    <string name="tab_ask">Ask</string>
    <string name="tab_result">Results</string>
    <string name="tab_docs">Documents</string>
    <!-- Must fit the field at 14sp without clipping. An EditText clips a
         hint rather than ellipsizing it, so an over-long hint loses its last
         word mid-glyph and the trailing "…" never draws at all. The empty
         state above carries the full list of topics; this only has to start
         the sentence. -->
    <string name="ask_hint">Ask about fees, timetables…</string>
    <string name="send">Send</string>
    <string name="roll_hint">Roll number or name</string>
    <string name="lookup">Look up</string>
    <string name="search_docs">Search documents</string>
    <string name="abstention">I don\'t have enough information to answer that.</string>
    <!-- The header pairs this with a live dot, so it states the fact rather
         than explaining itself in a sentence that had to be truncated. -->
    <string name="offline_banner">Offline</string>
    <string name="sources_label">SOURCES</string>
    <string name="ask_empty_title">Ask the college anything</string>
    <string name="result_empty_title">Look up a result</string>
    <string name="how_i_answered">How I answered this</string>
    <string name="ask_empty_hint">Fees, timetables, attendance, scholarships, placements, results. Every answer shows the document it came from.</string>
    <!-- Was: "This is the TABULAR route with a form instead of free text."
         Internal vocabulary on a screen a student reads. -->
    <string name="result_hint">Type a roll number, or any part of a name. Results are read from this college\'s own records, on the phone.</string>
    <string name="no_student">No student found.</string>

    <!-- Work in progress. Plain language, present tense, and honest about
         what is happening: retrieval reads the documents on the phone. -->
    <string name="ask_working">Looking through the documents…</string>

    <!--
      Failure copy. Two rules: say what actually broke, and say what the
      student can do next. A bare "something went wrong" makes an offline app
      look like a network app having a bad day, which is the one impression
      this product cannot afford.
    -->
    <string name="error_no_corpus_title">The documents are not on this device</string>
    <string name="error_no_corpus_body">The bundled corpus did not unpack when the app was installed. Reinstalling restores it. Nothing you have typed has left the phone.</string>
    <string name="error_answer_title">That question could not be answered</string>
    <string name="error_answer_body">Retrieval failed part way through. Rewording the question usually clears it. If it keeps happening, long-press the title to run the self test, which reports which part is broken.</string>

    <!--
      Document import.

      Two audiences read this copy and they want opposite things. A student
      adding a timetable wants to know it worked and that they can ask about
      it now. A student whose PDF was refused wants to know why and what to do
      instead. So every terminal state below names the outcome in the title
      and the next move in the body, and none of them says "error".
    -->
    <string name="add_document">Add a document</string>
    <string name="import_indexing">Indexing the document…</string>
    <!-- Shown while the chunk count is not yet knowable. The bar is
         indeterminate here and there is no count line, because a fraction the
         app cannot compute is worse than no fraction at all. -->
    <string name="import_extracting">Reading and splitting the file…</string>
    <!-- "23 of 51 passages". The second argument arrives already pluralised. -->
    <string name="import_progress_fmt">%1$d of %2$s</string>

    <!-- The count line above the list. Three cases and not one with a clause
         bolted on: before the student adds anything, the corpus is simply the
         college's and should not be described as a split. -->
    <string name="docs_count_fmt">%1$d documents in the on-device corpus</string>
    <string name="docs_count_split_fmt">%1$d college documents · %2$d added by you</string>
    <string name="docs_count_filtered_fmt">%1$d of %2$d documents match</string>

    <!-- The document's own title in the headline, because "Added" on its own
         does not tell a student which of the two files they just picked
         actually landed. -->
    <string name="import_ok_title_fmt">Added “%1$s”</string>
    <string name="import_ok_body_fmt">Indexed as %1$s. From your next question it is searched alongside the college\'s own documents.</string>
    <!-- The one thing a student must be able to act on: it is answerable now. -->
    <string name="import_ok_action">Ask about it</string>
    <string name="import_dismiss">Dismiss</string>

    <!--
      The honest limitation, stated where the claim is made rather than buried.

      An imported document is indexed for keyword and vector retrieval but has
      no graph edges: the bundle's edges came from an offline extraction step,
      and inventing them on the phone would push made-up relationships into the
      LOCAL route.

      The precise consequence is narrower than "it is invisible to LOCAL", and
      the copy must not overclaim in either direction. QueryRouter.answerLocal
      falls back to hybrid search when the graph misses, and that fallback does
      cover the user corpus — so a relationship question CAN be answered from
      an imported document. What cannot happen is being reached by following an
      edge from another document. Hence: searchable everywhere, linked nowhere.
    -->
    <string name="import_graph_note">Searched by keyword and by meaning, whatever the question. It has no links into the college\'s relationship map, so nothing will reach it by following a reference from another document.</string>
    <!-- Same document, no embedder. Keyword only is a real degradation and
         saying nothing would make the weaker results look like bad retrieval. -->
    <string name="import_keyword_only_note">The on-device language model is not available, so this document is searchable by the words it contains but not by meaning.</string>

    <string name="import_unsupported_title">That file could not be read</string>
    <string name="import_failed_title">That document was not added</string>
    <string name="import_no_repo">The documents are not available on this device, so there is nowhere to add this one. Reinstalling restores the corpus.</string>
    <!-- A shared file that arrives while another import is running. Queuing
         would mean holding a Uri whose read grant we cannot renew. -->
    <string name="import_busy">Another document is still being added. Wait for it to finish, then try again.</string>

    <!-- Provenance. The college's own documents are never marked; only the
         import is. See the comment on Source in data/Models.kt. The Documents
         tab's own "Added by you" heading is not duplicated here: it comes from
         UserCorpusDb.ADDED_CATEGORY, and a second copy would drift. -->
    <string name="source_added_by_you">Added by you — not a college document</string>

    <string name="remove_document">Remove</string>
    <string name="remove_title">Remove this document?</string>
    <string name="remove_body">It will be deleted from this phone and will no longer be searched. The college\'s own documents are not affected.</string>
    <string name="remove_confirm">Remove</string>
    <string name="remove_cancel">Keep</string>
    <string name="remove_failed">That document could not be removed.</string>

    <!-- The detail screen, reached from a Documents row or from a citation
         under an answer. The provenance rides on the passage count rather than
         taking a line of its own: it is the same fact the row already showed,
         and this screen's job is the document, not its paperwork. -->
    <string name="detail_added_meta_fmt">%1$s · added by you</string>

    <!--
      Enrolment.

      Same two rules as the import copy above, and one more that is specific to
      this screen: it must never read as a gate. Every answer this app gives is
      read from documents already on the phone, and that is true before
      enrolment, after it, and after a licence lapses. So the copy offers a
      confirmation, never demands one, and every terminal state below says out
      loud that answering is unaffected.

      On why there is a code and no verification email: this project's Supabase
      SMTP is capped at two mails an hour PROJECT-WIDE, so mailing 400 students
      is not a design that exists. `mailer_autoconfirm` is on, no mail is ever
      sent, and the institution's own code is what proves the student belongs
      to it. Nothing here may promise a message that will not arrive.
    -->
    <string name="enrol_title">Enrol this device</string>
    <string name="enrol_intro">Enrolment links this phone to your institution so its licence stays current. It is optional. Answers are read from the documents already on this phone and keep working either way, with or without a network.</string>

    <string name="enrol_email_label">Email</string>
    <!-- The address genuinely proves nothing here, so the field says so rather
         than implying a confirmation link is on its way. -->
    <string name="enrol_email_help">Optional, and no mail is ever sent to it. Leave it blank and the app makes one up — your enrolment code is what proves you belong to the institution.</string>
    <string name="enrol_email_hint">you@example.com</string>

    <string name="enrol_password_label">Password</string>
    <!-- The one consequence a student can act on: it is what gets them back in
         after a reinstall, so it is worth writing down. -->
    <string name="enrol_password_help">Six characters or more. You will need it if you reinstall the app on this phone or enrol a second one.</string>
    <string name="enrol_password_hint">Six characters or more</string>

    <string name="enrol_code_label">Enrolment code</string>
    <string name="enrol_code_help">From your college — on the enrolment slip, or from your department office. Capitals and spacing do not matter.</string>
    <string name="enrol_code_hint">Code from your college</string>

    <string name="enrol_submit">Enrol this device</string>
    <!-- Present tense, and honest about the one moment this app uses a
         network. Up to five calls with an eight-second timeout each, so this
         line can be on screen for a while on bad campus wifi. -->
    <string name="enrol_working">Confirming with your institution…</string>

    <!--
      Correction copy. It replaces the help line under the field it is about
      rather than appearing beneath it, so the form never grows a red row and
      never jumps under the student's thumb mid-typing.
    -->
    <string name="enrol_problem_email">That address has a typo — check the @ and the part after the last dot. Or clear the field and enrol without one.</string>
    <string name="enrol_problem_password">Six characters or more.</string>
    <string name="enrol_problem_code">The enrolment code is the one thing this screen needs. Your department office can reissue it.</string>

    <!--
      Terminal states. Four, matching Identity.EnrolResult exactly.

      "Already enrolled" is not among them and that is correct rather than an
      omission: a student who reinstalls redeems the same code, the server
      answers 23505, and ControlPlane treats that as the success it is — the
      membership row already exists and the grant is read exactly as it would
      have been. It arrives here as Enrolled. So the success copy below is
      written to be true of both histories at once: it names the institution
      and the confirmed window, and never says "welcome" or "recovered",
      because one of those is wrong on each of the two paths.
    -->
    <string name="enrol_done_title_fmt">Enrolled with %1$s</string>
    <string name="enrol_done_body_fmt">Offline access is confirmed for the next %1$s. Nothing about answering changes — it already worked offline — and opening the app once on a network before then renews the window.</string>
    <plurals name="enrol_days">
        <item quantity="one">%d day</item>
        <item quantity="other">%d days</item>
    </plurals>

    <!--
      One card for two causes, deliberately.

      Identity.EnrolResult.Rejected is raised both by the sign-in fallback (an
      account already exists at this address and the password differs) and by
      the code redemption (unknown, used up, expired). The result type does not
      say which, and the server's prose cannot be trusted to: SupabaseHttp
      falls back to the first 120 characters of the body, which on campus wifi
      may be a captive portal's HTML. So the outcome is named once, honestly,
      with a next move for each cause — and the server's own words are not
      printed, because they are not copy anyone wrote for a student to read.
    -->
    <string name="enrol_rejected_title">The code or the password was not accepted</string>
    <string name="enrol_rejected_body">Your institution checked both and turned one of them down. Retype the enrolment code exactly as it was issued; if you have already enrolled another phone with this email, use the password you chose then. Nothing on this device changed, and answers carry on as normal.</string>

    <string name="enrol_unavailable_title">Your institution could not be reached</string>
    <string name="enrol_unavailable_body">Enrolment is the one thing in this app that needs a connection, and it did not get one. Nothing was changed on this phone. Try again on wifi — in the meantime the app answers questions from its own documents, exactly as it does now.</string>

    <string name="enrol_not_configured_title">This build has no institution to enrol with</string>
    <string name="enrol_not_configured_body">No enrolment settings were installed alongside the app, so there is no service to contact. This is a supported setup, not a fault: the college\'s documents are bundled in the app and every answer comes from them. Your college\'s IT office can supply the settings file if enrolment is wanted.</string>

    <string name="enrol_action_done">Done</string>
    <string name="enrol_action_retry">Try again</string>
    <string name="enrol_action_back">Back</string>

    <!--
      The header pill, once a grant exists.

      Entitlements.shortBanner deliberately says nothing for a healthy grant —
      it was written when the pill had no name to show and silence was the
      whole point. Now that the pill names the institution, a healthy device
      would otherwise show a college name with no state beside it, which reads
      as a label rather than a status. One word closes that, and it is a
      statement of fact next to a name the student chose to put there, not a
      nag: an un-enrolled device still shows nothing at all.
    -->
    <string name="entitlement_active_short">enrolled</string>
    <!-- The pill is the way in to enrolment, so it has to announce itself to
         TalkBack and to a long-press tooltip. The title keeps the self test;
         one gesture, one destination. -->
    <string name="enrol_pill_tooltip">Enrolment</string>
    <string name="enrol_pill_description">Licence and enrolment</string>

    <!--
      The welcome, shown once.

      Four claims, and the copy rule for all of them is that each states
      something the student can go and check within a minute of dismissing
      this screen. That is why none of them is a feature list: "searches your
      college documents" is a boast, "every answer shows the document it came
      from, and you can tap it" is a test the app either passes or fails on
      the very first question.

      What is deliberately absent: any mention of enrolment, licences or
      accounts. This screen ends on a working Ask tab and nothing else. An
      onboarding flow that hands a new student to a sign-in form would make
      every promise on these four panes conditional, and none of them is.
    -->
    <string name="welcome_cited_title">Every answer shows its source</string>
    <string name="welcome_cited_body">Ask a question and the answer arrives with the college document it was read from, listed underneath. Tap it and you land on the exact passage. Nothing is offered that you cannot go and check.</string>

    <string name="welcome_offline_title">It works with no network</string>
    <string name="welcome_offline_body">The documents, the search index and the language model are all on this phone already. Turn on airplane mode and ask the same question — you get the same answer. There is no server here to be slow or to be down.</string>

    <string name="welcome_private_title">Your records never leave the phone</string>
    <string name="welcome_private_body">Questions, marks and attendance are read on the device and are never uploaded. This is structural rather than a promise: nothing on the path from your question to its answer opens a connection at all.</string>

    <string name="welcome_yours_title">Add your own documents</string>
    <string name="welcome_yours_body">Share a timetable, a notice or a syllabus to Campus Brain from any app and it is searched alongside the college\'s own. It stays on this phone too, and you can remove it whenever you like.</string>

    <!-- Plain, and offered from the first pane rather than appearing at the
         end. A skip that only shows up once you have read everything is not a
         skip. No "no thanks, I'll figure it out" — copy that makes leaving
         feel like a mistake is the thing this app should least resemble. -->
    <string name="welcome_skip">Skip</string>
    <string name="welcome_next">Next</string>
    <string name="welcome_start">Start asking</string>
    <string name="welcome_step_description">Step %1$d of %2$d</string>

    <!--
      ============================ Licensing ============================

      Two copy rules for everything below, and the first one governs the
      second.

      1. It may never read as a gate on answering, because it is not one.
         Every answer this app gives comes from documents already on the
         phone, at every tier, with no key and in airplane mode. A student on
         the free tier loses nothing from the Ask tab, the Documents tab, the
         four routes or the self test. So no string here says "upgrade to
         unlock", none of them describes the free tier as a trial, and the one
         limit that does exist is stated as a number rather than as a
         deprivation.

      2. No institution is named anywhere in this file. The college's name
         arrives inside the signed licence key and is rendered from that field.
         An app that writes a customer's name into its own resources has one
         customer; this one is sold to whoever holds a key. Every placeholder
         below is deliberately generic.
    -->

    <!-- The import allowance, reached. Not an error: nothing broke and the
         student did nothing wrong, so the headline states the fact and the
         body states the number. The plural is on the CAP, because "1 document"
         and "25 documents" are the same sentence and "%d document(s)" is the
         mark of a screen that did not care which it was saying. -->
    <string name="import_capped_title">This device\'s import allowance is used up</string>
    <plurals name="import_capped_docs_fmt">
        <item quantity="one">This licence covers %1$d imported document at a time. Remove the one already added and this file can take its place.</item>
        <item quantity="other">This licence covers %1$d imported documents. Remove one and this file can take its place.</item>
    </plurals>
    <string name="import_capped_kb_fmt">Imported documents come to %1$d KB and this licence covers %2$d KB. Removing a large one makes room.</string>
    <!-- The reassurance, and it is load-bearing. The single worst thing this
         feature could do is make an institution believe a lapsed licence has
         locked up documents they put in. It has not, it cannot, and the app
         says so at the exact moment the doubt would arise. -->
    <string name="import_capped_note">Everything already added is still here, still listed and still searched. A licence only ever affects adding something new.</string>

    <!-- The licence screen. Reached by long-pressing the header status pill:
         a third gesture on a surface that already carries two, and separate
         from both, because one gesture with two destinations is how a demo
         lands on the wrong screen with an audience watching. -->
    <string name="license_title">Licence</string>
    <string name="license_intro">Answering is not licensed and never will be. Every question is answered from the documents already on this phone, offline, at every tier. A licence raises how many of your own documents you can import and turns on the usage screen.</string>

    <string name="license_tier_label">Tier</string>
    <string name="license_tier_free">Free</string>
    <string name="license_tier_institutional">Institutional</string>
    <string name="license_tier_owner">Owner</string>

    <!-- The free tier described as what it is. "Import your own syllabus right
         now" is a thing a prospective buyer can do in the room; that is what
         the one document is for, and calling it a trial would misdescribe a
         product whose ask experience is not time-limited at all. -->
    <string name="license_free_body">No key on this device. Everything the app does with the college\'s own corpus is available and stays available. You can also import one document of your own — a syllabus, a timetable — and ask questions about it straight away.</string>
    <string name="license_institution_label">Licensed to</string>
    <string name="license_expires_fmt">Renews or expires on %1$s</string>
    <string name="license_expires_never">No expiry date</string>
    <string name="license_expired_fmt">Expired on %1$s. Imports are back to the free allowance; nothing already imported has changed.</string>

    <string name="license_usage_docs">Documents imported</string>
    <string name="license_usage_kb">Kilobytes imported</string>
    <string name="license_usage_fmt">%1$d of %2$d</string>

    <string name="license_key_label">Licence key</string>
    <string name="license_key_hint">CBI-XXXX-XXXX-…</string>
    <!-- Says where a key comes from and, just as importantly, that entering
         one is not required for anything on the Ask tab. -->
    <string name="license_key_help">Paste the key from your licence email. Dashes, spaces and capitals do not matter. Nothing is sent anywhere — the key is checked on this phone.</string>
    <string name="license_key_apply">Apply key</string>
    <string name="license_key_remove">Remove licence</string>

    <string name="license_applied_fmt">Licence applied for %1$s.</string>
    <!-- One line per rejection reason. Each one names what to do next, and
         none of them prints the key back to the screen. -->
    <string name="license_refused_malformed">That does not look like a licence key. It begins with CBI- and is a run of letters and digits in groups of four.</string>
    <string name="license_refused_truncated">That key is incomplete — some of it did not make it through the copy. Paste the whole line from the email.</string>
    <string name="license_refused_signature">That key was not issued for this app. Check you copied the whole line, then ask for it to be reissued.</string>
    <string name="license_refused_schema">That key was issued for a newer version of this app. Update the app, then enter it again.</string>
    <string name="license_refused_field">That key is not readable. Ask for it to be reissued.</string>
    <string name="license_refused_expired">That key has expired. Ask for a renewal — nothing on this phone changed, and every document already imported is untouched.</string>
    <string name="license_refused_device">That key was issued for a different device.</string>
    <!-- A defect in the app, not a mistyped key, so the copy does not send the
         admin back to check something that was probably correct. Reported
         separately from the malformed case because those two used to share a
         sentence, and a defect wearing the label for user error is a defect
         nobody investigates. -->
    <string name="license_refused_internal">That key could not be checked — this is a fault in the app rather than anything wrong with the key. Note the app version and report it; nothing on this device changed.</string>
    <!-- Verified, but the disk would not take it. Distinct copy, because the
         key is fine and telling the admin to re-check it would waste an hour. -->
    <string name="license_refused_storage">That key is valid, but this device\'s storage would not accept it. Restart the app and try once more.</string>
    <!-- The rule that protects a working install from a bad paste. -->
    <string name="license_unchanged_note">The licence already on this device is unchanged.</string>

    <!-- Behind a long-press on the tier label, following the header\'s own
         long-press precedent. A support affordance: an owner key is issued
         against this string, and nobody else ever needs to see it. -->
    <string name="license_install_id_fmt">Install id: %1$s</string>
    <string name="license_install_id_missing">This device has no install id — the licence store could not be opened.</string>

    <string name="license_analytics_action">Usage on this device</string>

    <!--
      ======================== Usage / analytics ========================

      Institutional and owner tiers only, and a screen rather than a report:
      everything on it was measured on this phone and none of it has ever left
      it.

      The copy rule specific to this screen is the one the answer path already
      lives by in AnswerCheck and PremiseCheck — never present an assumption as
      a measurement. Counts are measured. Minutes-per-question is typed in by
      whoever is reading the screen. The saving is the product of the two and
      is labelled as an estimate every single time it appears, including in the
      export.
    -->
    <string name="analytics_title">Usage on this device</string>
    <string name="analytics_intro">Counted on this phone and stored on it. Nothing here has been uploaded, and there is no code in the app that could upload it.</string>

    <string name="analytics_stat_questions">Questions</string>
    <string name="analytics_stat_abstained">Abstained</string>
    <string name="analytics_stat_abstain_rate">Abstention rate</string>
    <string name="analytics_routes_heading">How questions were answered</string>
    <!-- An abstention is a feature, so the screen says so rather than
         letting a number that looks like a failure rate stand alone. -->
    <string name="analytics_abstain_note">An abstention is the app declining to answer rather than guessing. It is the behaviour that makes the rest of the figures worth anything.</string>

    <string name="analytics_unused_heading">Documents never used</string>
    <string name="analytics_unused_empty">Every document in the corpus has been cited at least once.</string>
    <string name="analytics_unused_fmt">%1$d of %2$d documents have never been cited in an answer.</string>

    <string name="analytics_estimate_heading">Estimated staff time saved</string>
    <!-- The assumption, above the figure it produces, and editable. Putting it
         above is the whole design: a reader meets the input before the output
         and can dispute it before believing it. -->
    <string name="analytics_assumption_label">Minutes a person would have spent handling one question</string>
    <string name="analytics_assumption_hint">min</string>
    <string name="analytics_estimate_fmt">%1$s hours</string>
    <!-- Never omitted, never abbreviated, and repeated verbatim in the export.
         A bare hours figure on a slide is a claim the buyer cannot check. -->
    <string name="analytics_estimate_caveat">Estimated, based on the assumption above. The question counts are measured on this device; the minutes are not measured and are the figure you entered.</string>

    <string name="analytics_text_opt_in">Keep a local sample of question text</string>
    <string name="analytics_text_opt_in_help">Off by default. When on, recent questions are kept on this phone so you can read what students actually ask. Turning it off deletes what was kept. Question text is never transmitted at any setting.</string>

    <string name="analytics_export">Export</string>
    <string name="analytics_export_subject">Campus Brain — device usage</string>
    <string name="analytics_export_chooser">Export usage</string>
</resources>
