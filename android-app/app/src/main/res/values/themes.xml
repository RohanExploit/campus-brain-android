<resources>
    <style name="Theme.CampusBrain" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorOnPrimary">@color/on_brand</item>
        <!-- API 35 makes activities edge-to-edge by default, which drew the
             toolbar underneath the clock. fitsSystemWindows on the root plus
             an explicit status bar colour keeps the bar readable. -->
        <item name="android:statusBarColor">@color/brand</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:navigationBarColor">?android:colorBackground</item>
    </style>
</resources>
