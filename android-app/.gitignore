local.properties
.gradle/
build/
# Generated corpus bundle (~2MB), built by scripts/export_mobile_bundle.py.
# Excluded because it is a regenerable build artefact, not because of its
# contents: the student records in it are curated synthetic data authored
# for RAG evaluation, not real people.
app/src/main/assets/brain.db
# ~90MB embedder, generated by scripts/export_minilm_onnx.py
app/src/main/assets/minilm/

# Upload signing key. A leak here is unrecoverable: Play associates the app
# with this certificate forever, so it must never be committed.
keystore/
# Suffixed variants too: a bare `keystore.properties` pattern does not match
# `keystore.properties.bak`/`.aside`, which is exactly how a signing password
# becomes stageable during routine editing.
keystore.properties*
