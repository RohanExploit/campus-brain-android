# Copy to .env and fill in. .env is gitignored (holds real secrets).
# Every value here is optional — the app runs on localhost with all of them unset.

# ── API auth gate (api/main.py) ────────────────────────────────────────────
# OFF by default so localhost dev is frictionless. Turn ON before ever binding
# the server to 0.0.0.0 (see start.py). When enabled, every endpoint except
# /health requires an X-API-Key header (or ?api_key= for the SSE audit stream)
# resolving to a Principal (see auth/api_keys.py).
# API_KEY below is the ADMIN key (full access, sees all tenants — what the
# dashboard uses). REQUIRE_API_KEY=1 with an empty API_KEY AND no
# auth/api_keys.json present fails closed (500).
# Scoped, per-tenant keys (role "tenant", bound to one tenant_id) live in the
# optional auth/api_keys.json file — see auth/api_keys.example.json for the
# shape. That file is gitignored (holds secrets); copy the example and fill
# in real keys.
REQUIRE_API_KEY=0
API_KEY=

# Dashboard build-time copy of the same key (dashboard/src/lib/api.ts). Set this
# to the same value as API_KEY when REQUIRE_API_KEY=1, else the UI gets 401s.
# NEXT_PUBLIC_API_KEY=

# ── LLM / integrations ─────────────────────────────────────────────────────
# NVIDIA NIM fallback used by generation/answer.py when Ollama is unavailable.
NVIDIA_API_KEY=
# Bot integrations (bots/).
TELEGRAM_BOT_TOKEN=
WHATSAPP_WEBHOOK_SECRET=

# ── LLM egress / PII (generation/answer.py) ────────────────────────────────
# OFF by default, matching config.py: no prompt ever leaves the machine, and
# a test enforces it. Set 1 ONLY to opt into the NVIDIA cloud fallback when
# Ollama is unavailable — that ships prompt text, and therefore student data,
# to a third party. Leave this at 0 for any deployment holding real records.
ALLOW_EXTERNAL_LLM=0
# When ON, mask roll-number-like digit runs in the prompt before it leaves
# the machine.
LLM_PII_REDACTION=0

# ── Paths / validation knobs (config.py) — override only if you must ────────
# PROJECT_ROOT=            # force repo location; else auto-detected
# ENCRYPTION_KEY_PATH=     # default: <repo>/.encryption_key
# VALIDATE_TENANT_ID=1     # 0 disables all tenant_id path-traversal checks
# VALIDATE_UPLOAD_ID=1     # 0 disables upload_id shape checks
# VALIDATE_FILENAMES=1     # 0 disables upload filename sanitizing
# DEFAULT_TENANT_ID=tenant_1
# API_TIMEOUT=60           # seconds before an outbound LLM call is abandoned
# MAX_FILE_SIZE=52428800   # upload cap in bytes (default 50 MB)

# ── Text-to-SQL guardrails (retrieval/tabular_queries.py) ──────────────────
# SQL_ROW_LIMIT=200
# SQL_ALLOWED_TABLES=students,student_subjects,needs_review
